// # Sed Command Grammar and Parsing
//
// Logline: Decodes standard sed command strings into executable transformation instructions.
//
// Setup: Pure parser for s/find/replace/g, /pattern/d, and line operation primitives.
//
// Beats:
//   1. Define SedCommand data model with operation kinds, patterns, and flags.
//   2. Parse substitution commands respecting arbitrary delimiter characters.
//   3. Parse deletion, print, and conditional pattern filter instructions.

pub type SedCommand = struct {
    kind: String,
    pattern: String,
    replacement: String,
    global: Bool,
    line_number: Int
};

pub fn make_noop_command() -> SedCommand {
    return SedCommand {
        kind: "noop",
        pattern: "",
        replacement: "",
        global: false,
        line_number: -1
    };
}

fn split_sed_subst(cmd: String, delim: String) -> List[String] {
    let mut parts: List[String] = list_new();
    let n: Int = chars_len(cmd);
    let mut cur: String = "";
    let mut i: Int = 2;
    while i < n {
        let c: String = char_at(cmd, i);
        if c == "\\" && i + 1 < n && char_at(cmd, i + 1) == delim {
            cur = cur + delim;
            i = i + 1;
        } else if c == delim {
            parts = list_push(parts, cur);
            cur = "";
        } else {
            cur = cur + c;
        }
        i = i + 1;
    }
    parts = list_push(parts, cur);
    return parts;
}

pub fn parse_sed_command(raw_cmd: String) -> SedCommand {
    let cmd: String = str_trim(raw_cmd);
    let n: Int = chars_len(cmd);
    if n == 0 { return make_noop_command(); }

    if str_starts_with(cmd, "s") && n >= 3 {
        let delim: String = char_at(cmd, 1);
        let parts: List[String] = split_sed_subst(cmd, delim);
        let n_parts: Int = list_len(parts);
        let pattern: String = if n_parts > 0 { list_get(parts, 0) } else { "" };
        let repl: String = if n_parts > 1 { list_get(parts, 1) } else { "" };
        let flags: String = if n_parts > 2 { list_get(parts, 2) } else { "" };
        let is_global: Bool = str_contains(flags, "g");
        return SedCommand {
            kind: "subst",
            pattern: pattern,
            replacement: repl,
            global: is_global,
            line_number: -1
        };
    }

    if str_starts_with(cmd, "/") && str_ends_with(cmd, "/d") && n > 3 {
        let pat: String = str_slice(cmd, 1, n - 2);
        return SedCommand {
            kind: "delete",
            pattern: pat,
            replacement: "",
            global: false,
            line_number: -1
        };
    }

    if str_starts_with(cmd, "/") && str_ends_with(cmd, "/p") && n > 3 {
        let pat: String = str_slice(cmd, 1, n - 2);
        return SedCommand {
            kind: "print",
            pattern: pat,
            replacement: "",
            global: false,
            line_number: -1
        };
    }

    if cmd == "d" {
        return SedCommand { kind: "delete", pattern: "", replacement: "", global: false, line_number: -1 };
    }
    if cmd == "p" {
        return SedCommand { kind: "print", pattern: "", replacement: "", global: false, line_number: -1 };
    }

    return make_noop_command();
}
